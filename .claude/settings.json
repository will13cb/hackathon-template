{
  "permissions": {
    "allow": [
      "Bash(make test)",
      "Bash(make fmt)",
      "Bash(make doctor)",
      "Bash(make logs-gcp)",
      "Bash(make logs-aws)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git worktree list:*)",
      "Bash(curl -s:*)",
      "Bash(curl -fsS:*)",
      "Bash(gcloud run services describe:*)",
      "Bash(gcloud run services list:*)",
      "Bash(gcloud logging read:*)",
      "Bash(aws logs tail:*)",
      "Bash(aws sts get-caller-identity:*)",
      "Bash(aws lambda get-function:*)",
      "Bash(aws lambda get-function-url-config:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_bash.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/smoke.sh\"",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
