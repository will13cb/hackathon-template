# Copy to .env (gitignored): `cp .env.example .env`. Project/account IDs aren't secrets, but keep them out of git anyway.
# `make claude` loads this file before launching Claude Code so .mcp.json can expand these values.

SERVICE_NAME=hack-app            # keep the hack- prefix (the IAM policy is scoped to it)
LLM_PROVIDER=mock                # mock | vertex | bedrock (local dev only; deploy scripts set it per cloud)

# --- Google Cloud ---
GCP_PROJECT=                     # e.g. my-hackathon-123456
GCP_REGION=us-central1
VERTEX_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash    # check the newest: Vertex AI → Model Garden (e.g. gemini-3.x-flash)

# --- AWS ---
AWS_PROFILE=hackathon            # least-privilege profile Claude uses (see docs/SETUP.md)
AWS_ADMIN_PROFILE=default        # YOUR profile, only for `make aws-bootstrap` / teardown
AWS_REGION=us-east-1
# Default works with no extra setup. For Claude on Bedrock, find the inference-profile id:
#   aws bedrock list-inference-profiles --query "inferenceProfileSummaries[].inferenceProfileId" --output text | tr '\t' '\n' | grep anthropic
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# --- Local Google creds for vertex mode ---
GOOGLE_CLOUD_PROJECT=${GCP_PROJECT}
GOOGLE_CLOUD_LOCATION=${VERTEX_LOCATION}
